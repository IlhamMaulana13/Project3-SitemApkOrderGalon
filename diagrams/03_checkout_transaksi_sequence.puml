@startuml Checkout_Transaksi
!theme plain
title SD: Checkout & Pembayaran
actor Customer
participant "App (Flutter)" as App
participant "Backend" as API
participant "Midtrans" as Midtrans
database "Database" as DB

Customer -> App: Buka Checkout
App -> API: GET /profile/{uid}
API --> App: Nama, HP, Alamat
App -> API: GET /user-vouchers/{uid}
API --> App: Daftar voucher aktif
App --> Customer: Form checkout\n(profil · metode bayar · catatan · voucher)

Customer -> App: Konfirmasi pesanan

alt COD
    App -> API: POST /orders\n{user_id, items, total, notes, voucher}
    API -> DB: INSERT orders + order_items\nReserve stok
    DB --> API: order_id
    API --> App: 200 OK
    App --> Customer: Dialog "Pesanan Berhasil"

else Online (QRIS / VA / GoPay / ShopeePay)
    App -> API: POST /payment\n{order_id, total, customer_name, email, phone}
    API -> Midtrans: Create transaction
    Midtrans --> API: redirect_url
    API --> App: redirect_url
    App -> API: POST /orders\n{user_id, items, midtrans_order_id, notes, voucher}
    API -> DB: INSERT orders + order_items
    DB --> API: Success
    App --> Customer: Buka WebView pembayaran
    Customer -> Midtrans: Selesaikan pembayaran
    Midtrans -> API: POST /midtrans/callback (settlement)
    API -> DB: UPDATE payment_status = 'paid'\nKurangi stok (release reserved)
end

@enduml
