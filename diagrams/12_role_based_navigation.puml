@startuml Role_Based_Navigation
!theme plain
title Role-Based Navigation - Galon Rizzki Faras
skinparam ArrowColor #1976D2
skinparam ActivityBackgroundColor #E8F4F8
skinparam ActivityBorderColor #1976D2

start
:Login berhasil (Firebase Auth);
:GET /users/{uid};
:Ambil field role;

switch (role)
case (customer)
    :MainScreen;
    :BottomNavBar: Beranda · Keranjang · Pesanan · Profil;

case (kasir)
    :KasirScreen;
    :TabBar: Kasir (POS) · Riwayat;
    :Fitur: Pilih produk, input layanan,\nbayar tunai, lihat riwayat hari ini;

case (kurir)
    :KurirScreen;
    :Daftar pesanan (status ≠ Selesai);
    :Fitur: Update status, WA Customer;

case (admin)
    :AdminDashboardScreen;
    :Drawer: Pesanan · Produk · Voucher\n· Laporan · Sewa · Role;
endswitch

stop
@enduml
