@startuml Kelola_Voucher_Admin
!theme plain
title SD: Kelola Voucher (Admin)
actor Admin
participant "App (Flutter)" as App
participant "Backend" as API
database "Database" as DB

Admin -> App: Buka Kelola Voucher
App -> API: GET /vouchers
API -> DB: SELECT vouchers ORDER BY id DESC
DB --> API: List voucher
API --> App: JSON voucher
App --> Admin: Tampil daftar voucher\n(kode, nama, diskon, status aktif/nonaktif)

alt Buat Voucher
    Admin -> App: Isi nama, nominal\n(kode manual / auto-generate)
    App -> API: POST /vouchers\n{name, code, discount}
    API -> DB: INSERT vouchers (is_active = true)
    App --> Admin: "Voucher dibuat: [kode]"

else Edit Voucher
    Admin -> App: Klik pensil → ubah nama/kode/diskon
    App -> API: PUT /vouchers/{id}\n{name, code, discount}
    API -> DB: UPDATE vouchers
    App --> Admin: "Voucher berhasil diupdate"

else Toggle Aktif / Nonaktif
    Admin -> App: Pilih dari dropdown status
    App -> API: PUT /vouchers/{id}\n{is_active: true/false}
    API -> DB: UPDATE vouchers SET is_active
    App --> Admin: "Voucher diaktifkan / dinonaktifkan"

else Bagikan ke Customer
    Admin -> App: Klik "Bagikan ke Pelanggan"\nPilih semua / dropdown customer
    App -> API: POST /user-vouchers/assign\n{assign_all, email, voucher_codes}
    API -> DB: INSERT user_vouchers per customer
    App --> Admin: "Voucher berhasil dikirim"

else Lihat Penerima
    Admin -> App: Klik "Lihat Penerima Voucher"
    App -> API: GET /vouchers/{id}/recipients
    API -> DB: SELECT users JOIN user_vouchers
    DB --> API: List nama + email penerima
    App --> Admin: Dialog daftar penerima

else Hapus Voucher
    Admin -> App: Klik hapus → konfirmasi
    App -> API: DELETE /vouchers/{id}
    API -> DB: DELETE vouchers
    App --> Admin: "Voucher berhasil dihapus"
end

Admin -> App: Klik ikon ⚙ pada Reward Otomatis
App -> API: GET /reward-settings
API --> App: {multiplier, discount}
Admin -> App: Ubah kelipatan & nominal
App -> API: PUT /reward-settings\n{multiplier, discount}
App --> Admin: "Pengaturan reward disimpan"

@enduml
