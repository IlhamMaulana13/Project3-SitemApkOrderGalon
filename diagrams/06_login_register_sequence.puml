@startuml Login_Register
!theme plain
title SD: Login & Register
actor "User" as User
participant "App (Flutter)" as App
participant "Firebase Auth" as Firebase
participant "Backend" as API
database "Database" as DB

alt Register Baru
    User -> App: Input email, password, nama
    App -> Firebase: createUserWithEmailAndPassword()
    Firebase --> App: UserCredential (uid)
    App -> API: POST /users\n{firebase_uid, email, name, phone, fcm_token}
    API -> DB: INSERT users SET role = 'customer'
    DB --> API: Success
    App --> User: Masuk sebagai Customer

else Login
    User -> App: Input email & password
    App -> Firebase: signInWithEmailAndPassword()
    Firebase --> App: UserCredential (uid)
    App -> API: GET /users/{uid}
    API -> DB: SELECT role FROM users
    DB --> API: role
    API --> App: {role}
    App --> User: Redirect sesuai role\n(Customer / Kasir / Kurir / Admin)
end

@enduml
