@startuml Guest_Mode
!theme plain
title Alur Guest Mode
skinparam ArrowColor #D32F2F
skinparam ActivityBackgroundColor #FFEBEE
skinparam ActivityBorderColor #D32F2F

start

:User buka aplikasi tanpa login (Guest);

if (Fitur yang diakses?) then (Beranda)
    :Tampil produk normal;
    :Bisa pilih layanan & tambah ke keranjang;

elseif (Keranjang → Lanjut Bayar) then
    :Cek Firebase.currentUser == null;
    :Tampil dialog "Login Diperlukan";
    :Klik Login → redirect ke LoginScreen;

elseif (Tab Pesanan) then
    :Cek Firebase.currentUser == null;
    :Tampil dialog "Login Diperlukan"\n(barrierDismissible: false);
    :Klik Login → redirect ke LoginScreen;

elseif (Tab Profil) then
    :Cek Firebase.currentUser == null;
    :Tampil dialog "Login Diperlukan"\n(barrierDismissible: false);
    :Klik Login → redirect ke LoginScreen;
endif

stop
@enduml
