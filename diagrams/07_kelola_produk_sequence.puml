@startuml Kelola_Produk
!theme plain
title SD: Kelola Produk (Admin)
actor Admin
participant "App (Flutter)" as App
participant "Backend" as API
participant "ImgBB" as ImgBB
database "Database" as DB

Admin -> App: Buka Kelola Produk
App -> API: GET /products
API -> DB: SELECT products JOIN suppliers
DB --> API: List produk + supplier
API --> App: JSON produk
App --> Admin: Tampil daftar produk

alt Tambah Produk
    Admin -> App: Isi form\n(merk, harga jual, harga modal, stok, supplier, gambar)
    App -> ImgBB: Upload gambar
    ImgBB --> App: URL gambar
    App -> API: POST /products\n{merk, price, modal, stock, image, supplier_id}
    API -> DB: INSERT products
    App --> Admin: "Produk berhasil ditambah"

else Edit Produk
    Admin -> App: Klik edit → ubah data
    App -> API: PUT /products/{id}
    API -> DB: UPDATE products
    App --> Admin: "Produk berhasil diupdate"

else Hapus Produk
    Admin -> App: Klik hapus → konfirmasi
    App -> API: DELETE /products/{id}
    API -> DB: DELETE products
    App --> Admin: "Produk berhasil dihapus"
end

Admin -> App: Klik Supplier (AppBar)
App --> Admin: Dialog tabel supplier\n(nama, HP, alamat)

alt Tambah Supplier
    Admin -> App: Isi nama, HP, alamat
    App -> API: POST /suppliers
    API -> DB: INSERT suppliers
    App --> Admin: Supplier ditambah
end

@enduml
