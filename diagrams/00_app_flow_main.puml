@startuml App_Main_Flow
!theme plain
title Alur Utama Aplikasi - Galon Rizzki Faras
skinparam ArrowColor #1976D2
skinparam ActivityBackgroundColor #E8F4F8
skinparam ActivityBorderColor #1976D2

start
:Aplikasi dibuka;
:Cek Firebase Auth (currentUser);

if (Sudah Login?) then (Ya)
    :GET /users/{uid} — ambil role;

    switch (Role)
    case (customer)
        :MainScreen\nBottomNavBar: Beranda · Keranjang · Pesanan · Profil;
    case (kasir)
        :KasirScreen\nTab: POS · Riwayat Transaksi;
    case (kurir)
        :KurirScreen\nDaftar pesanan untuk dikirim;
    case (admin)
        :AdminDashboardScreen\nMenu: Pesanan · Produk · Voucher · Laporan · Sewa · Role;
    endswitch

else (Tidak)
    :AuthScreen — Login / Register;
    if (Login?) then (Ya)
        :Firebase signInWithEmailAndPassword();
        :GET /users/{uid} — cek role;
        :Redirect sesuai role;
    else (Register)
        :Firebase createUserWithEmailAndPassword();
        :POST /users — simpan ke DB;
        :Masuk sebagai Customer;
    endif
endif

stop
@enduml
