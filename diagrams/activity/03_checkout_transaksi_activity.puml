@startuml AD_Checkout_Transaksi
!theme plain
title Activity Diagram: Checkout & Pembayaran
skinparam ArrowColor #1976D2
skinparam ActivityBackgroundColor #E8F4F8
skinparam ActivityBorderColor #1976D2

start
:Buka halaman Checkout;
:Muat profil customer (nama, HP, alamat);
:Muat voucher aktif milik customer;

if (Voucher tersedia?) then (Ya)
    :Auto-apply voucher pertama;
else (Tidak)
    :Field voucher kosong;
endif

:Isi / cek form\n(alamat, metode bayar, catatan admin, voucher);
:Hitung total (subtotal - diskon);

if (Total = 0 & bukan COD?) then (Ya)
    :Tampil pesan "Gunakan COD untuk total Rp 0";
    stop
endif

:Klik "Bayar Sekarang";

if (Metode Pembayaran?) then (COD)
    :POST /orders (payment_channel = COD);
    :Simpan order + item ke database;
    :Tandai stok reserved;
    :Tampil dialog "Pesanan Berhasil";

else (Online — QRIS / VA / GoPay / ShopeePay)
    :POST /payment ke Backend;
    :Backend buat transaksi ke Midtrans;
    :Dapatkan redirect_url;
    :POST /orders ke database;
    :Buka WebView URL Midtrans;
    :Customer selesaikan pembayaran;
    :Midtrans kirim callback ke Backend;
    :Backend update status = paid;
    :Kurangi stok produk;
    :Tampil halaman Payment Success;
endif

:Bersihkan keranjang;

if (Ada item Sewa?) then (Ya)
    :Buat record rental di backend;
endif

stop
@enduml
