@startuml AD_Checkout_Transaksi
!theme plain
title Activity Diagram: Checkout & Pembayaran
skinparam ArrowColor #1976D2
skinparam ActivityBackgroundColor #E8F4F8
skinparam ActivityBorderColor #1976D2
skinparam SwimlaneBorderColor #1976D2

|Customer|
start
:Buka halaman Checkout;
:Cek & isi form\n(alamat, metode bayar, catatan, voucher);
:Hitung total\n(subtotal - diskon voucher);
:Klik "Bayar Sekarang";

if (Metode Pembayaran?) then (COD)
    |System|
    :POST /orders\n(payment_channel = COD);
    :Simpan order + item ke database;
    :Tandai stok reserved;
    |Customer|
    :Tampil dialog "Pesanan Berhasil";

else (Online — QRIS/VA/e-Wallet)
    |System|
    :POST /payment ke Backend;
    :Backend buat transaksi ke Midtrans;
    :Dapatkan redirect_url;
    :POST /orders ke database;
    |Customer|
    :Buka WebView Midtrans;
    :Selesaikan pembayaran;
    |System|
    :Midtrans kirim callback ke Backend;
    :Backend update payment_status = paid;
    :Backend kurangi stok produk;
    |Customer|
    :Tampil halaman Payment Success;
endif

|System|
:Bersihkan keranjang;
if (Ada item Sewa?) then (Ya)
    :Buat record rental\n(status = active);
endif

stop
@enduml
