@startuml AD_Role_Based_Navigation
!theme plain
title Activity Diagram: Role-Based Navigation
skinparam ArrowColor #1976D2
skinparam ActivityBackgroundColor #E8F4F8
skinparam ActivityBorderColor #1976D2

start
:Login berhasil (Firebase Auth);
:GET /users/{uid};
:Ambil field role dari database;

switch (Role)
case (customer)
    :Tampilkan MainScreen;
    :BottomNavBar\nBeranda · Keranjang · Pesanan · Profil;
    :Akses: lihat produk, beli,\nlihat pesanan, gunakan voucher;

case (kasir)
    :Tampilkan KasirScreen;
    :TabBar: Kasir (POS) · Riwayat;
    :Akses: input transaksi tunai,\ncatat sewa, lihat riwayat hari ini;

case (kurir)
    :Tampilkan KurirScreen;
    :Daftar pesanan (status ≠ Selesai);
    :Akses: update status pengiriman,\nhubungi customer via WhatsApp;

case (admin)
    :Tampilkan AdminDashboardScreen;
    :Drawer Menu:\nPesanan · Produk · Voucher\n· Laporan · Sewa · Role;
    :Akses: kelola semua data;
endswitch

stop
@enduml
