@startuml AD_Role_Based_Navigation
!theme plain
title Activity Diagram: Navigasi Berbasis Role
skinparam ArrowColor #1976D2
skinparam ActivityBackgroundColor #E8F4F8
skinparam ActivityBorderColor #1976D2
skinparam SwimlaneBorderColor #1976D2

|User|
start
:Login berhasil\n(Firebase Auth);

|System|
:GET /users/{uid};
:Ambil field role dari database;

if (Role?) then (customer)
    |User|
    :Tampil MainScreen;
    :Akses: Beranda, Keranjang,\nPesanan, Profil, Voucher;

elseif (kasir) then
    |User|
    :Tampil KasirScreen;
    :Akses: Transaksi Tunai,\nRiwayat Transaksi Hari Ini;

elseif (kurir) then
    |User|
    :Tampil KurirScreen;
    :Akses: Daftar Pesanan Aktif,\nHubungi Customer;

else (admin)
    |User|
    :Tampil AdminDashboardScreen;
    :Akses: Pesanan, Produk,\nVoucher, Laporan, Sewa, Role;
endif

stop
@enduml
