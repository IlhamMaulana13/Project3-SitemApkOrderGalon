@startuml AD_Kelola_Pesanan_Admin
!theme plain
title Activity Diagram: Kelola Pesanan (Admin)
skinparam ArrowColor #1976D2
skinparam ActivityBackgroundColor #E8F4F8
skinparam ActivityBorderColor #1976D2
skinparam SwimlaneBorderColor #1976D2

|Admin|
start
:Login sebagai Admin;
:Buka menu Kelola Pesanan;

|System|
:GET /orders — tampil semua pesanan;

|Admin|
:Baca detail pesanan\n(pelanggan, total, catatan, status);
:Pilih status baru dari dropdown\n(Diproses / Dikirim / Selesai);

|System|
:PUT /orders/status/{id} {status};
:Update status di database;

if (Status = "Selesai"?) then (Ya)
    if (Ada item Sewa?) then (Ya)
        :Catat rental aktif\nke tabel rentals;
    endif
    :Hitung total transaksi selesai customer;
    if (Memenuhi kelipatan reward?) then (Ya)
        :Generate voucher reward;
        :Simpan ke tabel user_vouchers;
    endif
    :Kirim FCM notifikasi\n"Pesanan anda telah selesai";

else (Diproses / Dikirim)
    :Kirim FCM notifikasi\nstatus terbaru ke customer;
endif

|Admin|
:Tampil "Status berhasil diupdate";

stop
@enduml
